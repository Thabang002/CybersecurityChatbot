<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛡️ Cybersecurity Awareness Chatbot - South Africa 🇿🇦"
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" 
                Background="{StaticResource PrimaryColor}" 
                CornerRadius="8" 
                Padding="15" 
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="🛡️" 
                           FontSize="28" 
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" 
                            Margin="15,0,0,0" 
                            VerticalAlignment="Center">
                    <TextBlock Text="Cybersecurity Awareness Assistant" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="🇿🇦 Educating South Africa about online safety" 
                               FontSize="12" 
                               Foreground="#B0BEC5"/>
                </StackPanel>

                <Button Grid.Column="2" 
                        Content="Show Activity Log" 
                        Style="{StaticResource SecondaryButton}"
                        Click="ShowActivityLog_Click"/>
            </Grid>
        </Border>

        <!-- Chat Area -->
        <Border Grid.Row="1" Grid.Column="0" 
                Background="White" 
                CornerRadius="8" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1"
                Margin="0,0,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chat Messages -->
                <ScrollViewer x:Name="ChatScrollViewer" 
                              Grid.Row="0" 
                              VerticalScrollBarVisibility="Auto"
                              Padding="10">
                    <StackPanel x:Name="ChatMessagesPanel"/>
                </ScrollViewer>

                <!-- Input Area -->
                <Border Grid.Row="1" 
                        Background="#F5F7FA" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="0,1,0,0"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="MessageTextBox" 
                                 Grid.Column="0" 
                                 FontSize="14" 
                                 Padding="10"
                                 VerticalContentAlignment="Center"
                                 KeyDown="MessageTextBox_KeyDown"/>

                        <Button x:Name="SendButton" 
                                Grid.Column="1" 
                                Content="Send" 
                                Style="{StaticResource PrimaryButton}"
                                Margin="5,0,0,0"
                                Click="SendButton_Click"/>

                        <Button x:Name="StartQuizButton" 
                                Grid.Column="2" 
                                Content="📝 Quiz" 
                                Style="{StaticResource SecondaryButton}"
                                Margin="5,0,0,0"
                                Click="StartQuiz_Click"
                                ToolTip="Start the cybersecurity quiz"/>

                        <Button x:Name="ClearChatButton" 
                                Grid.Column="3" 
                                Content="🗑️" 
                                Style="{StaticResource SecondaryButton}"
                                Margin="5,0,0,0"
                                Click="ClearChat_Click"
                                ToolTip="Clear chat history"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Side Panel -->
        <Border Grid.Row="1" Grid.Column="1" 
                Background="White" 
                CornerRadius="8" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1"
                Margin="0,0,0,10">
            <TabControl Background="White">
                <!-- Tasks Tab -->
                <TabItem Header="📋 Tasks">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Add New Task" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       Margin="0,0,0,10"/>

                            <TextBox x:Name="TaskTitleTextBox" 
                                     Text="Enable two-factor authentication" 
                                     FontSize="12" 
                                     Padding="8"
                                     Margin="0,0,0,5"/>

                            <TextBox x:Name="TaskDescriptionTextBox" 
                                     Text="Add 2FA to your email and social media accounts" 
                                     FontSize="12" 
                                     Padding="8"
                                     Margin="0,0,0,5"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox x:Name="HasReminderCheckBox" 
                                          Content="Set Reminder" 
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"/>
                                <DatePicker x:Name="ReminderDatePicker" 
                                            SelectedDate="{x:Static sys:DateTime.Now}"
                                            Width="120"/>
                            </StackPanel>

                            <Button Content="➕ Add Task" 
                                    Style="{StaticResource PrimaryButton}"
                                    Click="AddTask_Click"/>

                            <Border Height="1" Background="#E0E0E0" Margin="0,15,0,15"/>

                            <TextBlock Text="Your Tasks" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       Margin="0,0,0,10"/>

                            <ListBox x:Name="TasksListBox" 
                                     Height="250" 
                                     DisplayMemberPath="Title"
                                     SelectionChanged="TasksListBox_SelectionChanged"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Quiz Tab -->
                <TabItem Header="📝 Quiz">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Cybersecurity Quiz" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       Margin="0,0,0,10"/>

                            <TextBlock x:Name="QuizStatusText" 
                                       Text="Type 'Start quiz' in the chat to begin!" 
                                       FontSize="12" 
                                       Foreground="#666"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,15"/>

                            <Button Content="▶️ Start Quiz" 
                                    Style="{StaticResource PrimaryButton}"
                                    Click="StartQuiz_Click"/>

                            <Border Height="1" Background="#E0E0E0" Margin="0,15,0,15"/>

                            <TextBlock Text="Quiz History" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       Margin="0,0,0,10"/>

                            <ListBox x:Name="QuizHistoryListBox" 
                                     Height="200"
                                     DisplayMemberPath="ToString"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Help Tab -->
                <TabItem Header="❓ Help">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <TextBlock Text="How to Use the Chatbot" 
                                       FontWeight="Bold" 
                                       FontSize="16" 
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="🤖 **Cybersecurity Topics**" 
                                       FontWeight="Bold" 
                                       FontSize="14"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="• Passwords - Get tips on creating strong passwords" 
                                       FontSize="12" 
                                       Margin="10,0,0,5"/>
                            <TextBlock Text="• Scams - Learn to identify and avoid scams" 
                                       FontSize="12" 
                                       Margin="10,0,0,5"/>
                            <TextBlock Text="• Privacy - Tips for protecting your privacy online" 
                                       FontSize="12" 
                                       Margin="10,0,0,5"/>
                            <TextBlock Text="• Phishing - How to spot phishing attempts" 
                                       FontSize="12" 
                                       Margin="10,0,0,5"/>
                            <TextBlock Text="• 2FA - Understand two-factor authentication" 
                                       FontSize="12" 
                                       Margin="10,0,0,15"/>

                            <TextBlock Text="📋 **Task Management**" 
                                       FontWeight="Bold" 
                                       FontSize="14"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="• 'Add task: [title]' - Create a new task" 
                                       FontSize="12" 
                                       Margin="10,0,0,5"/>
                            <TextBlock Text="• 'Show tasks' - View all your tasks" 
                                       FontSize="12" 
                                       Margin="10,0,0,5"/>
                            <TextBlock Text="• 'Complete task [ID]' - Mark task as done" 
                                       FontSize="12" 
                                       Margin="10,0,0,15"/>

                            <TextBlock Text="📝 **Quiz**" 
                                       FontWeight="Bold" 
                                       FontSize="14"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="• 'Start quiz' - Begin the cybersecurity quiz" 
                                       FontSize="12" 
                                       Margin="10,0,0,5"/>
                            <TextBlock Text="• Answer with A, B, C, or D" 
                                       FontSize="12" 
                                       Margin="10,0,0,15"/>

                            <TextBlock Text="📋 **Other Commands**" 
                                       FontWeight="Bold" 
                                       FontSize="14"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="• 'Show activity log' - View recent actions" 
                                       FontSize="12" 
                                       Margin="10,0,0,5"/>
                            <TextBlock Text="• 'I'm worried about...' - Get empathetic responses" 
                                       FontSize="12" 
                                       Margin="10,0,0,5"/>
                            <TextBlock Text="• 'My name is...' - I'll remember your name!" 
                                       FontSize="12" 
                                       Margin="10,0,0,5"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" 
                Background="#F5F7FA" 
                CornerRadius="6" 
                Padding="10" 
                Margin="0,5,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" 
                           Text="Ready 🇿🇦" 
                           FontSize="11" 
                           Foreground="#666"/>
                <TextBlock Text=" | " FontSize="11" Foreground="#666" Margin="10,0"/>
                <TextBlock x:Name="UserInfoText" 
                           Text="👤 Guest" 
                           FontSize="11" 
                           Foreground="#666"/>
                <TextBlock Text=" | " FontSize="11" Foreground="#666" Margin="10,0"/>
                <TextBlock x:Name="TopicInfoText" 
                           Text="💡 Ask about cybersecurity!" 
                           FontSize="11" 
                           Foreground="#666"/>
                <TextBlock Text=" | " FontSize="11" Foreground="#666" Margin="10,0"/>
                <TextBlock x:Name="QuizStatusBarText" 
                           Text="📝 Quiz inactive" 
                           FontSize="11" 
                           Foreground="#666"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" 
                   Text="🇿🇦 Educating South Africa about cybersecurity • Made with ❤️" 
                   FontSize="10" 
                   Foreground="#999" 
                   HorizontalAlignment="Center" 
                   Margin="0,5,0,0"/>
    </Grid>
</Window>